# Site URL (for SEO canonical URLs, sitemap, OG images, and lead source links)
NEXT_PUBLIC_SITE_URL=https://pluspro.ca

# Optional: Web3Forms access keys (get one at web3forms.com).
# Quote, booking, and contact forms POST to /api/leads, which emails via Web3Forms.
# NEXT_PUBLIC_ keys still work if you already set them in Cloudflare.
# WEB3FORMS_ACCESS_KEY=your-contact-form-key
# WEB3FORMS_QUOTE_ACCESS_KEY=your-quote-form-key
# WEB3FORMS_BOOKING_ACCESS_KEY=your-booking-form-key
# NEXT_PUBLIC_WEB3FORMS_CAREERS_ACCESS_KEY=your-careers-form-key

# Quo API — server only. Never expose these to the browser.
# Create a key at https://my.quo.com → Settings → API
# Authorization header is the raw key (no Bearer prefix).
QUO_API_KEY=
# Optional. If unset, /api/leads resolves the inbox by matching +17786558980.
QUO_PHONE_NUMBER_ID=
# Signing secret from POST /v1/webhooks/calls (whsec_...). Used by /api/quo/webhook.
QUO_WEBHOOK_KEY=
