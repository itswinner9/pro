# Frontend-only site – no backend required

# Site URL (for SEO canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://pluspro.ca

# Optional: Google Analytics 4 measurement ID (default: G-SYMTD4RS2T is already set in code)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-SYMTD4RS2T

# Optional: Web3Forms access key for contact/quote/booking forms (get one at web3forms.com)
# If not set, the app uses a built-in key for contact; you can set separate keys per form:
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-contact-form-key
# NEXT_PUBLIC_WEB3FORMS_QUOTE_ACCESS_KEY=your-quote-form-key
# NEXT_PUBLIC_WEB3FORMS_BOOKING_ACCESS_KEY=your-booking-form-key
